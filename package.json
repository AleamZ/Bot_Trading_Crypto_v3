{
  "name": "bot-trading-crypto-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev -w @bot-v3/server",
    "start": "npm run start -w @bot-v3/server",
    "hash-password": "npm run hash-password -w @bot-v3/server",
    "dev:web": "npm run dev -w @bot-v3/web"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.13"
  }
}
