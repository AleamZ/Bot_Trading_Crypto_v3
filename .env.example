# Copy to .env and fill in. Never commit .env. Booleans are read as text: only "true" or "false".

NODE_ENV=production
HOST=127.0.0.1
PORT=8787
# The public address of the web UI. An https:// URL makes the login cookie Secure.
PUBLIC_URL=https://bot-trade.aleam.io.vn

# Binance USDT-M Futures. This version only accepts "demo" (https://demo-fapi.binance.com).
BINANCE_ENV=demo
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Master switch for placing orders. With "false" the UI cannot turn auto trading on.
TRADING_ENABLED=false

# Telegram: create the bot with @BotFather. Leave the chat id empty at first, send /start to the bot,
# and it replies with your chat id (also shown in the UI); put it here and restart.
# Use a different bot token for a copy running on your own PC: two processes cannot poll one token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Single admin login for the web UI. `npm run hash-password` prints both lines below.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Relative to the folder of this file. One bot per database (a lock file next to it enforces that).
DB_PATH=./data/bot.db
LOG_LEVEL=info
